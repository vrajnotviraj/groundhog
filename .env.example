# Target application
BASE_URL=https://app.example.com

# Credential VALUES only — the login flow is discovered live by the agent and
# cached as replayable steps; fill_secret steps store field names, never values.
LOGIN_USER=you@example.com
LOGIN_PASS=your-password
# Workspace selected right after login so every session starts consistently.
LOGIN_WORKSPACE=Your Workspace

# LLM — Anthropic only.
ANTHROPIC_API_KEY=
# SMART plans and optimizes; FAST drives per-step decisions, healing, judging.
SMART_MODEL=claude-sonnet-5
FAST_MODEL=claude-haiku-4-5

# Neo4j (docker compose up -d). The graph accelerates the agent; nothing requires it.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=groundhog

# Budgets
CRAWL_MAX_PAGES=40
CRAWL_MAX_DEPTH=4
EXECUTOR_MAX_ACTIONS=25
STEP_TIMEOUT_MS=8000
SETTLE_TIMEOUT_MS=1500

# Docs fallback for unknown features
DOCS_URL=https://docs.example.com

HEADLESS=1
