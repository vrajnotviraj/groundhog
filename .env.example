BASE_URL=https://app.example.com
LOGIN_USER=you@example.com
LOGIN_PASS=your-password
LOGIN_WORKSPACE=Your Workspace
# Optional: opens that workspace directly instead of picking LOGIN_WORKSPACE by name.
# WORKSPACE_ID=
TYPESAFE_API_KEY=

# Optional: unlocks `flow new` and lets the agent write field values the intent
# doesn't spell out.
# ANTHROPIC_API_KEY=

# other knobs (timeouts, thresholds, models): see groundhog/config.py
