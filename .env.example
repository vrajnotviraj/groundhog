# Copy to .env and fill in. `uv run groundhog init` checks every line.

# --- App under test (required) ---
BASE_URL=https://app.example.com
LOGIN_USER=you@example.com
LOGIN_PASS=your-password
LOGIN_WORKSPACE=Your Workspace
# Optional: opens this workspace directly instead of picking LOGIN_WORKSPACE by name.
# WORKSPACE_ID=

# --- Console ---
# Mongo database for cases, flows, runs and users.
MONGO_URL=mongodb://localhost:27017/groundhog
# First admin's email (required), created by `groundhog db seed` when there are no users.
ADMIN_EMAIL=
# Empty generates a password and prints it once.
ADMIN_PASSWORD=
# How many runs the console runs at once; the rest wait as queued.
# MAX_WORKERS=3

# --- Models ---
# Required: makes every browser decision (new, heal, judge).
TYPESAFE_API_KEY=
# jev-latest is jev-1.14.0 today. Pin TYPESAFE_MODEL=jev-1.14.0 to keep answers
# consistent across releases.
# TYPESAFE_MODEL=jev-latest

# Optional: needed for `flow new` and suggested tests, and lets the agent write
# field values the intent doesn't spell out.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Browser ---
# Set to 0 to watch the browser while it runs.
# HEADLESS=1

# --- Timeouts, in milliseconds (defaults shown) ---
# PAGE_LOAD_MS=45000
# STEP_TIMEOUT_MS=10000
# SETTLE_TIMEOUT_MS=1000
# ACTION_PROBE_MS=2000
# READINESS_POLL_MS=250

# --- Agent limits and thresholds (defaults shown) ---
# EXECUTOR_MAX_ACTIONS=40
# CRAWL_MAX_PAGES=40
# CRAWL_MAX_DEPTH=4
# JUDGE_THRESHOLD=0.6
# HEAL_THRESHOLD=0.6
